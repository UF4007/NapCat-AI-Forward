# Copy to .env and fill in.
WEBUI_TOKEN=change-me

# Must match the token of the "ws" WebSocket server in NapCat's WebUI (empty by default).
ONEBOT_TOKEN=

# Any OpenAI-compatible endpoint, e.g. https://api.deepseek.com/v1 or http://host.docker.internal:11434/v1 (Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# Optional
SYSTEM_PROMPT=
ALLOW_GROUPS=
