# Copy to .env and fill in.
WEBUI_TOKEN=change-me

# Must match the token of the "ws" WebSocket server in NapCat's WebUI (empty by default).
ONEBOT_TOKEN=

# Any OpenAI-compatible endpoint, e.g. https://api.deepseek.com/v1 or http://host.docker.internal:11434/v1 (Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# Image recognition: set to true only if LLM_MODEL accepts image input (e.g. gpt-4o-mini, qwen-vl);
# text-only models reject requests that contain images.
VISION=false
# Also send stickers / shop faces to the model (usually just wastes tokens).
VISION_STICKERS=false

# Optional
SYSTEM_PROMPT=
HISTORY_MESSAGES=
ALLOW_GROUPS=
IMAGE_MAX_MB=
